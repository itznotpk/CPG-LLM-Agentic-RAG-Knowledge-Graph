# =====================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# =====================================================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# =====================================================
# NEO4J CONFIGURATION (Knowledge Graph)
# =====================================================
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# =====================================================
# LLM CONFIGURATION
# =====================================================
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_api_key
LLM_CHOICE=gemini-2.5-flash
INGESTION_LLM_PROVIDER=bedrock
INGESTION_LLM_CHOICE=your-ingestion-model-id
FORMATTER_LLM_CHOICE=your-formatter-model-name

# =====================================================
# GEMINI FLASH via Google AI Studio
# =====================================================
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# =====================================================
# STAGE 2 - extraction + hypotheses
# =====================================================
STAGE2_LLM_PROVIDER=openai
STAGE2_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
STAGE2_LLM_API_KEY=your_stage2_api_key
STAGE2_LLM_CHOICE=gemini-2.5-flash

# =====================================================
# STAGE 2 RE-RANK
# =====================================================
STAGE2_RERANK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
STAGE2_RERANK_LLM_API_KEY=your_stage2_rerank_api_key
STAGE2_RERANK_LLM_CHOICE=gemini-2.5-flash

# =====================================================
# STAGE 4 - query generation
# =====================================================
STAGE4_LLM_PROVIDER=openai
STAGE4_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
STAGE4_LLM_API_KEY=your_stage4_api_key
STAGE4_LLM_CHOICE=gemini-2.5-flash

# =====================================================
# STAGE 5 - synthesis
# =====================================================
STAGE5_LLM_PROVIDER=openai
STAGE5_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
STAGE5_LLM_API_KEY=your_stage5_api_key
STAGE5_LLM_CHOICE=gemini-2.5-flash

# =====================================================
# STAGE 6 - safety critic
# =====================================================
SAFETY_CRITIC_LLM_PROVIDER=openai
SAFETY_CRITIC_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SAFETY_CRITIC_LLM_API_KEY=your_safety_critic_api_key
SAFETY_CRITIC_MODEL=gemini-2.5-flash

# =====================================================
# AWS & EMBEDDING CONFIGURATION (Bedrock)
# =====================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v1
RERANKER_MODEL=cohere.rerank-v3-5:0
BEDROCK_MODEL_ID=your_bedrock_model_id

# =====================================================
# CHUNKING CONFIGURATION
# =====================================================
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MAX_CHUNK_SIZE=2000
VECTOR_DIMENSION=1536

# =====================================================
# APPLICATION CONFIGURATION & LIMITS
# =====================================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8058
LOG_LEVEL=INFO
DEBUG_MODE=false

SESSION_TIMEOUT_MINUTES=60
MAX_MESSAGES_PER_SESSION=100
MAX_SEARCH_RESULTS=10

# =====================================================
# WHO ICD-11 API CONFIGURATION
# =====================================================
ICD11_API_CLIENT_ID=your_icd11_client_id
ICD11_API_CLIENT_SECRET=your_icd11_client_secret
ICD11_API_RELEASE_ID=2024-01
ICD11_API_LINEARIZATION=mms
ICD11_API_LANGUAGE=en

# =====================================================
# GOOGLE CLOUD SPEECH-TO-TEXT (STT)
# =====================================================
GOOGLE_CLOUD_STT_API_KEY=your_google_cloud_stt_api_key

# =====================================================
# CONSULTATION SUMMARY MODEL
# =====================================================
CONSULTATION_SUMMARY_MODEL=gemini-2.5-flash

# =====================================================
# GCS - Temporary consultation audio (deleted post-STT)
# =====================================================
GCS_CONSULTATION_BUCKET=your-consultation-audio-temp-bucket
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json  # only if NOT using ADC

# =====================================================
# GMAIL DELIVERY CONFIGURATION
# =====================================================
# Gmail address used to send care-plan PDFs to patients.
GMAIL_USER=your_gmail@gmail.com
# App Password generated at https://myaccount.google.com/apppasswords
# Requires 2FA enabled on the Gmail account.
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Display name shown in the From: header.
GMAIL_FROM_NAME=ClearPath
# Set to false to disable the background delivery worker (e.g. in test environments).
DELIVERY_WORKER_ENABLED=true

# =====================================================
# CHATBOX — Care-plan explainer
# =====================================================
CHATBOX_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHATBOX_LLM_API_KEY=your_chatbox_api_key
CHATBOX_LLM_CHOICE=gemini-2.5-flash

# =====================================================
# SUPABASE CONFIGURATION (Real-time Database & Auth)

# =====================================================
# ATOMIC CLINICAL LLM OVERRIDES (set complete tuples)
# =====================================================
STAGE2_RERANK_LLM_PROVIDER=openai
STAGE5_LLM_PROVIDER=openai
REFERRAL_GATE_PROVIDER=openai
REFERRAL_GATE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
REFERRAL_GATE_API_KEY=your_referral_gate_api_key
REFERRAL_GATE_MODEL=gemini-2.5-flash
PRIOR_VISIT_SUMMARISER_PROVIDER=openai
PRIOR_VISIT_SUMMARISER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PRIOR_VISIT_SUMMARISER_API_KEY=your_prior_summary_api_key
PRIOR_VISIT_SUMMARISER_MODEL=gemini-2.5-flash
PREP_BRIEF_LLM_PROVIDER=openai
PREP_BRIEF_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PREP_BRIEF_LLM_API_KEY=your_prep_brief_api_key
PREP_BRIEF_LLM_MODEL=gemini-2.5-flash
FOLLOWUP_LLM_PROVIDER=openai
FOLLOWUP_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FOLLOWUP_LLM_API_KEY=your_followup_api_key
FOLLOWUP_LLM_MODEL=gemini-2.5-flash
CHATBOX_LLM_PROVIDER=openai

# =====================================================
# BUILD / CORPUS IDENTITY AND OPERATIONAL TELEMETRY
# =====================================================
RUN_LIVE_PROVIDER_TESTS=0
APP_COMMIT_SHA=unknown
CPG_CORPUS_VERSION=unknown
OTEL_TRACING_ENABLED=false
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=cpg-llm
LOGFIRE_DISABLED=true
LOGFIRE_TOKEN=
OFFLINE_LOG_DIR=logs

# =====================================================
# PIPELINE DETERMINISM, CHECKPOINTS, AND TEST HARNESS
# =====================================================
DDX_DETERMINISTIC_SEED=42
CHAPTER21_DEMOTION_TOLERANCE=0.03
STAGE3_HEADLESS_GAP=0.10
PIPELINE_CHECKPOINT_ENABLED=false
PIPELINE_CHECKPOINT_DIR=.checkpoints
PIPELINE_CHECKPOINT_TTL_MIN=60
ALLOW_FORCE_RERANK=false
FORCE_RERANK_ORDER=

# =====================================================
# FOLLOW-UP WORKER / TELEGRAM
# =====================================================
FOLLOWUP_WORKER_ENABLED=false
FOLLOWUP_DEMO_MODE=false
FOLLOWUP_TIME_SCALE=1
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_telegram_bot_username

# =====================================================
# OPTIONAL PROVIDER AND MODEL OVERRIDES
# =====================================================
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
INGESTION_LLM_BASE_URL=
INGESTION_LLM_API_KEY=
GRAPHITI_LLM_PROVIDER=openai
GRAPHITI_LLM_BASE_URL=
GRAPHITI_LLM_API_KEY=
GRAPHITI_LLM_CHOICE=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
SYMPTOM_EXTRACT_MODEL=gemini-2.5-flash
VISION_MODEL=gemini-2.5-flash
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Direct Postgres connection for asyncpg (delivery worker). URL-encode the password if it contains special chars (@ : / # ? & = +).
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
