# =====================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# =====================================================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# =====================================================
# NEO4J CONFIGURATION (Knowledge Graph)
# =====================================================
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# =====================================================
# LLM CONFIGURATION
# =====================================================
LLM_PROVIDER=openai
LLM_BASE_URL=https://your-llm-provider/v1
LLM_API_KEY=your_api_key
LLM_CHOICE=your-model-name

# =====================================================
# GMAIL DELIVERY CONFIGURATION
# =====================================================
# Gmail address used to send care-plan PDFs to patients.
GMAIL_USER=your_gmail@gmail.com
# App Password generated at https://myaccount.google.com/apppasswords
# (requires 2FA enabled on the Gmail account)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Display name shown in the From: header
GMAIL_FROM_NAME=Demo Clinic
# Set to false to disable the background delivery worker (e.g. in test environments)
DELIVERY_WORKER_ENABLED=true

# =====================================================
# AWS & EMBEDDING CONFIGURATION (Bedrock)
# =====================================================
AWS_ACCESS_KEY_ID=your_key_id
AWS_SECRET_ACCESS_KEY=your_secret
AWS_DEFAULT_REGION=us-east-1
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v1

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8058
LOG_LEVEL=INFO

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
