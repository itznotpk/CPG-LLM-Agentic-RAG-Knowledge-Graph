:begin
UNWIND [{start: {_id:21}, end: {_id:22}, properties:{chunk_index:0, evidence:"→ PDE5i (phosphodiesterase-5 inhibitors)", created_at:datetime('2026-04-30T12:07:49.18Z'), source_document:"SECTION 1: CLINICAL DECISION ALGORITHMS", source:"section-1-algorithm.md"}}, {start: {_id:314}, end: {_id:45}, properties:{chunk_index:0, evidence:"Phosphodiesterase-5-inhibitor should be offered to all patients with erectile dysfunction unless contraindicated.", created_at:datetime('2026-04-30T12:25:48.489Z'), source_document:"SECTION 3: TREATMENT", source:"section-3-treatment.md"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
