// REL (['Procedure'])-[OTHER]->(['Condition']): {'chunk_index': 0, 'evidence': 'Improved sexual function with IIEF score difference of 6.7 at 4 and 6 months', 'created_at': neo4j.time.DateTime(2026, 4, 30, 12, 28, 56, 851000000, tzinfo=<UTC>), 'source_document': 'SECTION 8: SPECIAL POPULATIONS', 'source': 'section-8-special-populations.md'}
// REL (['Organization'])-[RECOMMENDED_FOR]->(['PatientProfile']): {'chunk_index': 0, 'evidence': 'A multidisciplinary team consisting of cardiologist, urologist, family medicine specialist, psychiatrist and/or rehabilitative physician are important in managing patients with ED and cardiac disease', 'created_at': neo4j.time.DateTime(2026, 4, 30, 12, 28, 56, 919000000, tzinfo=<UTC>), 'source_document': 'SECTION 8: SPECIAL POPULATIONS', 'source': 'section-8-special-populations.md'}
// REL (['Procedure'])-[RECOMMENDED_FOR]->(['PatientProfile']): {'chunk_index': 0, 'evidence': 'They should be: Regularly screened for ED and vice versa', 'created_at': neo4j.time.DateTime(2026, 4, 30, 12, 28, 56, 940000000, tzinfo=<UTC>), 'source_document': 'SECTION 8: SPECIAL POPULATIONS', 'source': 'section-8-special-populations.md'}
// REL (['Procedure'])-[RECOMMENDED_FOR]->(['PatientProfile']): {'chunk_index': 0, 'evidence': 'They should be: Advocated for optimisation of glycaemic control and other risk factors', 'created_at': neo4j.time.DateTime(2026, 4, 30, 12, 28, 57, 1000000, tzinfo=<UTC>), 'source_document': 'SECTION 8: SPECIAL POPULATIONS', 'source': 'section-8-special-populations.md'}
// REL (['Procedure'])-[TREATS]->(['Condition']): {'chunk_index': 0, 'evidence': 'Combination of VED + Tadalafil 20 mg showed significantly higher IIEF scores at 6-12 months compared to Tadalafil alone', 'created_at': neo4j.time.DateTime(2026, 4, 30, 12, 28, 57, 75000000, tzinfo=<UTC>), 'source_document': 'SECTION 8: SPECIAL POPULATIONS', 'source': 'section-8-special-populations.md'}
// REL (['Procedure'])-[RECOMMENDED_FOR]->(['PatientProfile']): {'chunk_index': 0, 'evidence': 'Multimodal penile rehabilitation with nerve sparing approach may help improve EF post-radical prostatectomy', 'created_at': neo4j.time.DateTime(2026, 4, 30, 12, 28, 57, 102000000, tzinfo=<UTC>), 'source_document': 'SECTION 8: SPECIAL POPULATIONS', 'source': 'section-8-special-populations.md'}
